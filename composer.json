{
    "name": "guidance-studio/filament-tenant-members",
    "description": "Multi-tenant organization, member and invitation management for Laravel Filament",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Guidance\\FilamentTenantMembers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guidance\\FilamentTenantMembers\\FilamentTenantMembersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    }
}
